{% extends 'base.html.twig' %}

{% block title %}myGoals - Frontpage{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script>
    $(document).on('click','.estado', function() {

    const $btn = $(this);
    const eventType = $btn.attr('data-event-type');
    const eventId = $btn.attr('data-event-id');

    // Construimos la URL usando el ID directamente

    const url = `/set-event-status/${eventType}/${eventId}`;

       $.ajax({
          type: "POST",
          url: url,
          success: function(response) {

          location.reload();

        }
        });
    });

    // Cuando pinchas en el botón del evento para abrir el dialog de eliminar

    $(document).on('click','.eliminar', function() {

    const $btn = $(this);
    const eliminarId = $btn.attr('data-event-id');
    const cambiarEstado = document.getElementById("boton_eliminar");
    $(cambiarEstado).attr('data-event-id', eliminarId);

    });

    // Cuando pinchas en el botón para eliminar definitivamente

    $(document).on('click','#boton_eliminar', function() {

    const $btn = $(this);
    const eventId = $btn.attr('data-event-id');

    // Construimos la URL usando el ID directamente
    const url = `/delete-event/${eventId}`;

       $.ajax({
          type: "POST",
          url: url,
          success: function(response) {

          location.reload();

        }
        });
    });
    </script>

{% endblock %}



{% block body %}
  <nav class="navbar navbar-expand-lg navbar-light bg-light">
    <div class="container-fluid">
      <a class="navbar-brand" href="#">myGoals</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarSupportedContent">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <li class="nav-item">
            <a class="nav-link active" aria-current="page" href="#">Home</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#">Link</a>
          </li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              Dropdown
            </a>
            <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
              <li><a class="dropdown-item" href="#">Action</a></li>
              <li><a class="dropdown-item" href="#">Another action</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" href="#">Something else here</a></li>
            </ul>
          </li>
          <li class="nav-item">
            <a class="nav-link disabled" href="#" tabindex="-1" aria-disabled="true">Disabled</a>
          </li>
        </ul>
        <form class="d-flex">
          <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search">
          <button class="btn btn-outline-success" type="submit">Search</button>
        </form>
      </div>
    </div>
  </nav>

  <main role="main" class="container">

      <div class="starter-template">

      <h1>Evento</h1>

      <h1>{{event.name}}</h1>

      <br><br>

      <div class="progress mb-4" style="height: 30px; border-radius: 15px; overflow: hidden;">
            <div id="progressBar"
                 class="progress-bar"
                 role="progressbar"
                 style="width: 0%; height: 30px; padding: 0;"
                 aria-valuenow="{{ porcentajeHechos|round(0) }}"
                 aria-valuemin="0"
                 aria-valuemax="100">
                0%
            </div>
      </div>
        <script>
        document.addEventListener("DOMContentLoaded", () => {
            const progressBar = document.getElementById("progressBar");
            if (!progressBar) return;

            const porcentaje = parseInt(progressBar.getAttribute("aria-valuenow"));

            // Asignar color según horquillas
            if (porcentaje <= 20) {
                progressBar.classList.add('bg-danger');
            } else if (porcentaje <= 60) {
                progressBar.classList.add('bg-warning');
            } else if (porcentaje < 100) {
                progressBar.classList.add('bg-info');
            } else {
                progressBar.classList.add('bg-success');
            }

            // Animación desde 0 hasta porcentaje
            setTimeout(() => {
                progressBar.style.width = porcentaje + "%";
                progressBar.textContent = porcentaje + "%";
            }, 50);
        });
        </script>

        <h2 class="row text-start">Información Del Evento</h2>
        <br><br>

        <dl class="row text-start">
          <dt class="col-sm-2">Categoría:</dt>
          <dd class="col-sm-10" id="tarea_cat">{{event.category}}</dd>
          <dt class="col-sm-2">Inicio:</dt>
          <dd class="col-sm-10">{{event.start|date("d/m/Y H:s")}}</dd>
          <dt class="col-sm-2">Fin:</dt>
          <dd class="col-sm-10">{{event.endtime|date("d/m/Y H:s")}}</dd>
          <dt class="col-sm-2">Descripción:</dt>
          <dd class="col-sm-10">{{event.description}}</dd>
        </dl>

        <br>

        <h2 class="row text-start">Subtareas</h2>
        <br><br>

        {% if event.subtasks|length > 0 %}
        {% for subtarea in event.subtasks %}
        <dl class="row text-start">
          <dt class="col-sm-2">Tarea:</dt>
          <dd class="col-sm-10">{{subtarea.name}}</dd>
          <dt class="col-sm-2">Inicio:</dt>
          <dd class="col-sm-10">{{subtarea.start|date("d/m/Y H:s")}}</dd>
          <dt class="col-sm-2">Fin:</dt>
          <dd class="col-sm-10">{{subtarea.endtime|date("d/m/Y H:s")}}</dd>
          <dd class="col-sm-12">
          {% if subtarea.status == false %}

          <button type="button" class="btn btn-success btn-sm estado" title="Cambiar Estado" data-event-type="subtask" data-event-id="{{ subtarea.id }}">
              <i class="bi bi-check-circle"></i>
          </button>
          {% else %}
          <button type="button" class="btn btn-danger btn-sm estado" title="Cambiar Estado" data-event-type="subtask" data-event-id="{{ subtarea.id }}">
              <i class="bi bi-x-circle"></i>
          </button>
          {% endif %}
          </dd>
        </dl>
        {% endfor %}
        {% else %}
        No hay subtareas.
        {% endif %}
        </p>




      </div>





<div class="modal" id="modalEliminar" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" data-evento="titulo">Eliminar Tarea</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body">
        <p>¿Estás seguro? Si haces click en "Eliminar" se eliminará la tarea principal y las subtareas asociadas a ella de forma definitiva.</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
        <button type="button" class="btn btn-danger" id="boton_eliminar" data-event-id="">Eliminar</button>
      </div>
    </div>
  </div>
</div>



</main>

{% endblock %}

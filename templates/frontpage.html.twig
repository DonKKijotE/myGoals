</nav>

  <main role="main" class="container">

      <div class="starter-template">

      <h1 class="text-center">Progreso Semanal</h1>

      <h2 class="text-center"><button type="button" class="btn btn-secondary"><i class="bi bi-rewind"></i></button> {{ fechainicio|date("d/m/Y") }} - {{ fechafin|date("d/m/Y") }} <button type="button" class="btn btn-secondary"><i class="bi bi-fast-forward"></i></button> </h2>

        <br><br>

        <dl class="row">
          <dt class="col-2">
              Global
          </dt>
          <dd class="col-10">
          <div class="progress mb-4" style="height: 30px; border-radius: 15px; overflow: hidden;">
              <div id="progressBar"
                   class="progress-bar"
                   role="progressbar"
                   style="width: 0%; height: 30px; padding: 0;"
                   aria-valuenow="{{ porcentajeHechos|round(0) }}"
                   aria-valuemin="0"
                   aria-valuemax="100">
                  0%
              </div>
          </div>
          </dd>
          <dt class="col-2">
            Categorías
          </dt>
          <dd class="col-sm-10">
          <div class="progressBarVisual" style="height:12px;">
              {% for cat in categoriesData %}
                  <div class="segment {{ cat.color_class }}"
                       data-width="{{ cat.porcentaje_global }}%"
                       style="width:0%; position:relative; display:flex; align-items:center; justify-content:center;">

                       <div style="width: {{ cat.porcentaje_interno }}%; height:100%; background: rgba(0,0,0,0.1); position:absolute; left:0; top:0;"></div>
                       <span style="font-size:10px; line-height:12px; z-index:1;">{{ cat.nombre }}</span>
                  </div>
              {% endfor %}
          </div>
          </dd>

        </dl>

        <script>
        document.addEventListener("DOMContentLoaded", () => {
            const progressBar = document.getElementById("progressBar");
            if (!progressBar) return;

            const porcentaje = parseInt(progressBar.getAttribute("aria-valuenow"));

            // Asignar color según horquillas
            if (porcentaje <= 20) {
                progressBar.classList.add('bg-danger');
            } else if (porcentaje <= 60) {
                progressBar.classList.add('bg-warning');
            } else if (porcentaje < 100) {
                progressBar.classList.add('bg-info');
            } else {
                progressBar.classList.add('bg-success');
            }

            // Animación desde 0 hasta porcentaje
            setTimeout(() => {
                progressBar.style.width = porcentaje + "%";
                progressBar.textContent = porcentaje + "%";
            }, 50);
        });

        document.addEventListener("DOMContentLoaded", () => {
            document.querySelectorAll('.progressBarVisual .segment').forEach(segment => {
                const targetWidth = segment.dataset.width; // tomar ancho final del dataset
                setTimeout(() => {
                    segment.style.width = targetWidth; // animar hasta el valor real
                }, 50);
            });
        });
        </script>


        {% for fila in events|batch(4, null) %}
            <div class="row mb-4 mb-4 justify-content-start">
                {% for evento in fila %}
                    {% if evento %}
                        <div class="col-12 col-sm-6 col-md-3">
                            <div class="card h-100" id="event-{{ evento.id }}">
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title">{{ evento.title }}</h5>

                                    <p class="card-text flex-grow-1">
                                        {{ evento.description }}
                                    </p>
                                    <div class="d-flex justify-content-between mt-auto">
                                        <a href="{{ path('view_event', {id: evento.id}) }}"<button type="button" class="btn btn-info btn-sm" title="Ver Detalles">
                                            <i class="bi bi-zoom-in"></i>
                                        </button></a>
                                        <button type="button" class="btn btn-primary btn-sm" title="Editar Evento" data-bs-toggle="modal" data-bs-target="#eventoModal{{ evento.id }}">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        {% if evento.status == false %}
                                        <button type="button" class="btn btn-success btn-sm estado" title="Cambiar Estado" data-event-type="task" data-event-id="{{ evento.id }}">
                                            <i class="bi bi-check-circle"></i>
                                        </button>
                                        {% else %}
                                        <button type="button" class="btn btn-danger btn-sm estado" title="Cambiar Estado" data-event-type="task" data-event-id="{{ evento.id }}">
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                        {% endif %}
                                        <button type="button" class="btn btn-danger btn-sm eliminar" title="Eliminar" data-event-id="{{ evento.id }}" data-bs-toggle="modal" data-bs-target="#modalEliminar">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        {% endfor %}




      </div>

      {% for evento in events %}
        <div class="modal fade" id="eventoModal{{ evento.id }}" tabindex="-1" aria-labelledby="eventoModalLabel{{ evento.id }}" aria-hidden="true">
          <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
              <div class="modal-header">
                <h5 class="modal-title text-uppercase" id="eventoModalLabel{{ evento.id }}">{{ evento.title }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
              </div>
              <div class="modal-body">
                {{ evento.description }}
                <br><br>
                <dl class="row">
                  <dt class="col-sm-3">Categoría:</dt>
                  <dd class="col-sm-9" id="tarea_cat"><i class="{{evento.category.icon}}" style="color: {{evento.category.color}}"></i> {{evento.category.name}}</dd>
                  <dt class="col-sm-3">Inicio:</dt>
                  <dd class="col-sm-9">{{evento.start|date("d/m/Y H:i", app.user.timezone)}}</dd>
                  <dt class="col-sm-3">Fin:</dt>
                  <dd class="col-sm-9">{{evento.end|date("d/m/Y H:i", app.user.timezone)}}</dd>
                </dl>
                <h5 class="modal-title">Subtareas</h5>
                <br>
                {% if evento.subtasks|length > 0 %}
                {% for subtarea in evento.subtasks %}
                <dl class="row">
                  <dt class="col-sm-3">Tarea:</dt>
                  <dd class="col-sm-9">{{subtarea.title}}</dd>
                  <dt class="col-sm-3">Inicio:</dt>
                  <dd class="col-sm-9">{{subtarea.start|date("d/m/Y H:i", app.user.timezone)}}</dd>
                  <dt class="col-sm-3">Fin:</dt>
                  <dd class="col-sm-9">{{subtarea.end|date("d/m/Y H:i", app.user.timezone)}}</dd>
                </dl>
                {% endfor %}
                {% else %}
                No hay subtareas.
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      {% endfor %}



<div class="modal" id="modalEliminar" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" data-evento="titulo">Eliminar Tarea</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body">
        <p>¿Estás seguro? Si haces click en "Eliminar" se eliminará la tarea principal y las subtareas asociadas a ella de forma definitiva.</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
        <button type="button" class="btn btn-danger" id="boton_eliminar" data-event-id="">Eliminar</button>
      </div>
    </div>
  </div>
</div>



</main>

{% endblock %}

<main role="main" class="container">

<h1 class="text-center">Eventos Agendados</h1>

<div id='calendar'></div>

<div class="modal fade" id="verEvento" tabindex="-1" aria-labelledby="verEventoLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="verEventoLabel">Detalles De La Tarea</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <dl class="row">
          <dt class="col-sm-3">Tarea:</dt>
          <dd class="col-sm-9 text-capitalize" id="tarea_nombre">Nombre de la tarea</dd>
          <dt class="col-sm-3">Descripción:</dt>
          <dd class="col-sm-9" id="tarea_desc">Descripción de la tarea</dd>
          <dt class="col-sm-3">Categoría:</dt>
          <dd class="col-sm-9" id="tarea_cat">Categoría de la tarea</dd>
          <dt class="col-sm-3">Inicio:</dt>
          <dd class="col-sm-9" id="tarea_inicio">Fecha de inicio de la tarea</dd>
          <dt class="col-sm-3">Fin:</dt>
          <dd class="col-sm-9" id="tarea_fin">Fecha de fin de la tarea</dd>
          <dt class="col-sm-6"><button id="estado" data-action="change-status" data-event-type="task" data-event-id="" ></button></dt>
        </dl>
      </div>
    </div>
  </div>
</div>

<!-- Modal -->
<div class="modal fade" id="crearEvento" tabindex="-1" aria-labelledby="crearEventoLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="crearEventoLabel">Crear Tarea</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
      {# {{ form(form) }} #}

      <div class="form">



                <form action="{{ path('frontpage_currentweek') }}" method="post">

                <div class="mb-3">
                    {{ form_row(form.name, { label:'Título', attr: { 'class': 'form-control', 'placeholder': 'Nombre de la tarea.' } }) }}
                </div>

                <div class="mb-3">
                    {{ form_row(form.description, { label:'Información Adicional', attr: { 'class': 'form-control', 'placeholder': 'Información adicional.', 'rows': '4' } }) }}

                </div>

                <div class="mb-3">
                    {{ form_row(form.category, { label:'Categoría', attr: { 'class': 'form-control', 'placeholder': 'Categoría' } }) }}
                </div>

                <div class="mb-3">
                    {{ form_row(form.start, { label:'Inicio', attr: { 'class': 'form-control', 'placeholder': 'Inicio' } }) }}
                </div>

                <div class="mb-3">
                    {{ form_row(form.endtime, { label:'Fin', attr: { 'class': 'form-control', 'placeholder': 'Fin' } }) }}
                </div>

                <div class="mb-3 form-check">

                <input type="checkbox" class="form-check-input" id="task_recurrente">
                    <label class="form-check-label" for="task_recurrente">Tarea Recurrente</label>
                </div>

                <div id="recurrence_fields" style="display:none;">
                    <div class="mb-3">
                        {{ form_row(form.recurrence_type, { label: 'Tipo de recurrencia', attr: { 'class': 'form-control' } }) }}
                    </div>
                    <div class="mb-3">
                        {{ form_row(form.recurrence_interval, { label: 'Intervalo', attr: { 'class': 'form-control', 'min':1 } }) }}
                    </div>
                    <div class="mb-3">
                        {{ form_row(form.recurrence_count, { label: 'Número de repeticiones', attr: { 'class': 'form-control', 'min':1, 'max':30 } }) }}
                    </div>
                </div>

                <button type="button" class="add_item_link btn btn-info" data-collection-holder-class="subtasks">Add a subtask</button>

                <br><br>

                <ul class="subtasks lista"
                    data-index="{{ form.subtasks|length > 0 ? form.subtasks|last.vars.name + 1 : 0 }}"
                    data-prototype="{{ form_widget(form.subtasks.vars.prototype)|e('html_attr') }}"
                ></ul>


                <div class="mb-3">
                    <button class="btn btn-primary" type="submit">Crear Tarea</button>
                </div>

                {{ form_rest(form) }}

                </form>
      </div>
    </div>
  </div>
</div>

</main>

{% endblock %}
